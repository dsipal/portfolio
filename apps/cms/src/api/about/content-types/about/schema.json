{
  "kind": "singleType",
  "collectionName": "abouts",
  "info": {
    "singularName": "about",
    "pluralName": "abouts",
    "displayName": "About",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "About me"
    },
    "header": {
      "type": "string"
    },
    "body": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "github": {
      "type": "string"
    },
    "linkedIn": {
      "type": "string"
    },
    "resumeUrl": {
      "type": "string"
    },
    "resumeLabel": {
      "type": "string",
      "default": "Résumé"
    },
    "resumeFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "coverLetterUrl": {
      "type": "string"
    },
    "coverLetterLabel": {
      "type": "string",
      "default": "Cover letter"
    },
    "coverLetterFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "currentPosition": {
      "displayName": "currentPosition",
      "type": "component",
      "repeatable": false,
      "component": "about.current-position"
    },
    "nowHeading": {
      "type": "string",
      "default": "Now"
    },
    "currentlyWorkingOn": {
      "type": "string"
    },
    "skillsHeading": {
      "type": "string",
      "default": "What I do"
    },
    "skills": {
      "displayName": "skills",
      "type": "component",
      "repeatable": true,
      "component": "about.skills"
    },
    "toolboxHeading": {
      "type": "string",
      "default": "Toolbox"
    },
    "tech": {
      "displayName": "tech",
      "type": "component",
      "repeatable": true,
      "component": "about.tech"
    }
  }
}
