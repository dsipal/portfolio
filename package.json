{
  "name": "portfolio",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:cms": "pnpm --filter cms dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e",
    "mock-strapi": "pnpm --filter web mock-strapi",
    "format": "prettier --write \"apps/web/{app,components,lib,test,e2e}/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
