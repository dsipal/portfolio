# Traefik (runs as a separate, shared stack — these must match its config)
TRAEFIK_NETWORK=traefik              # external docker network Traefik watches
TRAEFIK_HTTPS_ENTRYPOINT=websecure   # entrypoint names from Traefik's static config
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_PREFIX=portfolio             # router/service name prefix; must be unique across stacks

# Domains
PORTFOLIO_DOMAIN=devinsipal.com
GHOST_DOMAIN=admin.devinsipal.com    # Ghost admin at https://<GHOST_DOMAIN>/ghost

# MySQL (Ghost's production database) — generate passwords with: openssl rand -base64 32
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Ghost mail (SMTP). Ghost emails staff invites and sign-in codes for new
# devices. Without SMTP, set GHOST_STAFF_DEVICE_VERIFICATION=false or you can't
# sign in from a new browser.
GHOST_MAIL_FROM=
GHOST_SMTP_HOST=
GHOST_SMTP_PORT=587
GHOST_SMTP_USER=
GHOST_SMTP_PASSWORD=
# GHOST_STAFF_DEVICE_VERIFICATION=false

# Ghost Content API key (Ghost Admin → Settings → Integrations → add custom integration)
# Runtime: set here. Build time (prerendering in CI): GitHub Actions secret GHOST_CONTENT_API_KEY
GHOST_CONTENT_API_KEY=

# On-demand revalidation: in the same Ghost integration, add webhooks for the
# post, page, tag and "Site changed" events pointing at
# https://<PORTFOLIO_DOMAIN>/api/revalidate/ with this value as the secret
# (Ghost signs each request with it). Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Images (production compose pulls these; built by .github/workflows/build.yml)
# IMAGE_REGISTRY=ghcr.io/dsipal
# IMAGE_TAG=latest   # set to a commit SHA to pin/roll back

# NOTE: GHOST_URL (build-time prerendering) and NEXT_PUBLIC_GA_TRACKING_ID are
# baked into the web image at build time. For production they are GitHub
# Actions repository *variables*, not entries in this file.
