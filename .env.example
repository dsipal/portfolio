# Traefik (runs as a separate, shared stack — these must match its config)
TRAEFIK_NETWORK=traefik              # external docker network Traefik watches
TRAEFIK_HTTPS_ENTRYPOINT=websecure   # entrypoint names from Traefik's static config
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_PREFIX=portfolio             # router/service name prefix; must be unique across stacks

# Domains
PORTFOLIO_DOMAIN=devinsipal.com
STRAPI_DOMAIN=admin.devinsipal.com

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=changeme

# Strapi secrets — generate each with: openssl rand -base64 32
# APP_KEYS must be a comma-separated list of 4 values
APP_KEYS=key1,key2,key3,key4
ADMIN_JWT_SECRET=changeme
API_TOKEN_SALT=changeme
TRANSFER_TOKEN_SALT=changeme
USERS_PERMISSIONS_JWT_SECRET=changeme

# Cloudinary (production media uploads)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Strapi API token (create in Strapi Admin → Settings → API Tokens)
# Runtime: set here. Build time (prerendering in CI): GitHub Actions secret STRAPI_API_TOKEN
STRAPI_API_TOKEN=

# On-demand revalidation: Strapi webhook (Settings → Webhooks) POSTs to
# https://<PORTFOLIO_DOMAIN>/api/revalidate/ with header
# "Authorization: Bearer <REVALIDATE_SECRET>". Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Images (production compose pulls these; built by .github/workflows/build.yml)
# IMAGE_REGISTRY=ghcr.io/dsipal
# IMAGE_TAG=latest   # set to a commit SHA to pin/roll back

# NOTE: NEXT_PUBLIC_STRAPI_API_URL and NEXT_PUBLIC_GA_TRACKING_ID are baked into
# the web image at build time. For production they are GitHub Actions repository
# *variables*, not entries in this file.
